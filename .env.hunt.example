# Back-catalog search settings. `just init` copies this to the private .env.hunt.
# API keys are read automatically from data/sonarr/config.xml and data/radarr/config.xml.

# HUNT_SONARR=true
# HUNT_RADARR=true
# HUNT_MISSING_BATCH_SIZE=10
# HUNT_UPGRADE_BATCH_SIZE=5
# HUNT_DELAY_SECONDS=60
# HUNT_MAX_ITEMS_PER_RUN=100
# HUNT_MAX_QUEUE_SIZE=0
# HUNT_COOLDOWN_DAYS=7
