.env
.env.*
!.env.example
!.env.restic.example
!.env.hunt.example

# Python administration scripts
__pycache__/
*.py[cod]

# data/ is app config state (untracked, never commit). `data/*` auto-covers any
# new runtime subdir; only the traefik, crowdsec, coredns, recyclarr + prowlarr
# config-as-code files are tracked. The static configs are mounted directly;
# runtime state remains ignored.
# Recyclarr's runtime state (secrets.yml, cache, logs) stays ignored; only the
# shipped configs, settings, custom formats, and bootstrap script are tracked.
data/*
!data/hunt/
data/hunt/*
!data/hunt/.gitkeep
!data/traefik/
data/traefik/*
!data/traefik/traefik.yml
!data/traefik/dynamic.yml
!data/crowdsec/
data/crowdsec/*
!data/crowdsec/acquis.yaml
!data/coredns/
data/coredns/*
!data/coredns/Corefile
!data/recyclarr/
data/recyclarr/*
!data/recyclarr/bootstrap.sh
!data/recyclarr/settings.yml
!data/recyclarr/configs/
data/recyclarr/configs/*
!data/recyclarr/configs/radarr.yml
!data/recyclarr/configs/sonarr.yml
!data/recyclarr/custom-formats/
data/recyclarr/custom-formats/*
!data/recyclarr/custom-formats/sonarr/
data/recyclarr/custom-formats/sonarr/*
!data/recyclarr/custom-formats/sonarr/hi10.json
!data/recyclarr/custom-formats/sonarr/anime-dual-audio-languages.json
# Prowlarr's runtime state (config.xml, DB, logs, downloaded indexer
# definitions) stays ignored.
