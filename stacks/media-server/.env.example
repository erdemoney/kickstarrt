DOMAIN=
# uid/gid the containers run as: `just init` proposes this user's ids (1000 when
# root). Must be numeric (0-65535); while empty, compose falls back to 1000.
ENV_PUID=
ENV_PGID=

# Per-panel subdomains; `just init` fills each with the app name as the default.
SUB_DOMAIN_JELLYFIN=
SUB_DOMAIN_SEERR=
SUB_DOMAIN_RADARR=
SUB_DOMAIN_SONARR=
SUB_DOMAIN_PROWLARR=
SUB_DOMAIN_BAZARR=
SUB_DOMAIN_DECYPHARR=
# Comet's admin dashboard (tailnet-only, like the other panels).
SUB_DOMAIN_COMET=

# Public Traefik routers are disabled by default. These are managed by
# `just public enable|disable <service>`; they do not open UFW or create DNS records.
# JELLYFIN_ENTRYPOINTS=
# SEERR_ENTRYPOINTS=
# RADARR_ENTRYPOINTS=
# SONARR_ENTRYPOINTS=
# PROWLARR_ENTRYPOINTS=
# BAZARR_ENTRYPOINTS=
# DECYPHARR_ENTRYPOINTS=

# Comet (DMM indexer) + its Postgres database. `just init` prompts for the
# dashboard password; it must be set before the first `just up`. Comet is
# tailnet-only: Prowlarr reaches it at http://comet:8000 and the admin
# dashboard at https://comet.<DOMAIN> (SUB_DOMAIN_COMET above).
COMET_POSTGRES_PASSWORD=
ADMIN_DASHBOARD_PASSWORD=
