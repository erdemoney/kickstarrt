DOMAIN=
# uid/gid the containers run as: `just init` proposes this user's ids (1000 when
# root). Must be numeric (0-65535); while empty, compose falls back to 1000.
ENV_PUID=
ENV_PGID=

# Per-panel subdomains; `just init` fills each with the app name as the default.
SUB_DOMAIN_JELLYFIN=
SUB_DOMAIN_SEERR=
SUB_DOMAIN_RADARR=
SUB_DOMAIN_SONARR=
SUB_DOMAIN_PROWLARR=
SUB_DOMAIN_BAZARR=
SUB_DOMAIN_DECYPHARR=
# Comet's admin dashboard (tailnet-only, like the other panels).
SUB_DOMAIN_COMET=

# Public Traefik routers are disabled by default. These are managed by
# `just public enable|disable <service>`; they do not open UFW or create DNS records.
# JELLYFIN_ENTRYPOINTS=
# SEERR_ENTRYPOINTS=
# RADARR_ENTRYPOINTS=
# SONARR_ENTRYPOINTS=
# PROWLARR_ENTRYPOINTS=
# BAZARR_ENTRYPOINTS=
# DECYPHARR_ENTRYPOINTS=

# Comet (DMM indexer) + its Postgres database. `just init` prompts for the
# dashboard password; it must be set before the first `just up`. Comet is
# tailnet-only: Prowlarr reaches it at http://comet:8000 and the admin
# dashboard at https://comet.<DOMAIN> (SUB_DOMAIN_COMET above).
COMET_POSTGRES_PASSWORD=
ADMIN_DASHBOARD_PASSWORD=

# Optional Comet scrapers that need credentials (Debridio / TorBox / AIOStreams).
# Uncomment and fill to enable; compose.yaml keeps the SCRAPE_* toggles off
# (false) until the matching key is set. StremThru (public, keyless) and the
# background pre-cacher are enabled directly in compose.yaml.
# SCRAPE_DEBRIDIO=true
# DEBRIDIO_API_KEY=
# DEBRIDIO_PROVIDER=realdebrid
# DEBRIDIO_PROVIDER_KEY=
# SCRAPE_TORBOX=true
# TORBOX_API_KEY=
# SCRAPE_AIOSTREAMS=true
# AIOSTREAMS_URL=
# AIOSTREAMS_USER_UUID_AND_PASSWORD=
#
# AIOStreams note: the URL must stay non-empty when the toggle is off (Comet
# validates it at import and crashes on an empty string). Unset, compose.yaml
# passes a harmless placeholder; set AIOSTREAMS_URL here to use the real API.
