DOMAIN=
# uid/gid the containers run as: `just init` proposes this user's ids (1000 when
# root). Must be numeric (0-65535); while empty, compose falls back to 1000.
ENV_PUID=
ENV_PGID=

# Per-panel subdomains; `just init` fills each with the app name as the default.
SUB_DOMAIN_JELLYFIN=
SUB_DOMAIN_SEERR=
SUB_DOMAIN_RADARR=
SUB_DOMAIN_SONARR=
SUB_DOMAIN_PROWLARR=
SUB_DOMAIN_BAZARR=
SUB_DOMAIN_INFINIDYSK=

# InfiniDysk headless configuration secrets. `just init` prompts for the NNTP
# account and creates the API/WebDAV keys. The provider JSON is shell-quoted as
# a Compose literal so punctuation in credentials survives interpolation.
FRONTEND_BACKEND_API_KEY=
WEBDAV_USER=
WEBDAV_PASS=
NZBDAV_CONFIG__USENET__PROVIDERS=
# `just wire` fills this JSON with the Sonarr/Radarr API keys for InfiniDysk.
NZBDAV_CONFIG__ARR__INSTANCES=

# Public Traefik routers are disabled by default. These are managed by
# `just public enable|disable <service>`; they do not open UFW or create DNS records.
# JELLYFIN_ENTRYPOINTS=
# SEERR_ENTRYPOINTS=
# RADARR_ENTRYPOINTS=
# SONARR_ENTRYPOINTS=
# PROWLARR_ENTRYPOINTS=
# BAZARR_ENTRYPOINTS=
# INFINIDYSK_ENTRYPOINTS=

# Ephemeral Sonarr/Radarr back-catalog search job. Copy the API keys from each
# app's Settings -> General -> Security page. The hunt container has no ports
# and runs only when invoked by `just hunt-run` or its systemd timer.
HUNT_SONARR_API_KEY=
HUNT_RADARR_API_KEY=
# HUNT_MODE=both
# HUNT_SONARR=true
# HUNT_RADARR=true
# HUNT_MISSING_BATCH_SIZE=10
# HUNT_UPGRADE_BATCH_SIZE=5
# HUNT_DELAY_SECONDS=60
# HUNT_MAX_ITEMS_PER_RUN=100
# HUNT_MAX_QUEUE_SIZE=0
# HUNT_COOLDOWN_DAYS=7
