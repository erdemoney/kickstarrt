DOMAIN=
# uid/gid the containers run as: `just init` proposes this user's ids (1000 when
# root). Must be numeric (0-65535); while empty, compose falls back to 1000.
ENV_PUID=
ENV_PGID=

# Per-panel subdomains; `just init` fills each with the app name as the default.
SUB_DOMAIN_JELLYFIN=
SUB_DOMAIN_SEERR=
SUB_DOMAIN_RADARR=
SUB_DOMAIN_SONARR=
SUB_DOMAIN_PROWLARR=
SUB_DOMAIN_BAZARR=
SUB_DOMAIN_INFINIDYSK=

# InfiniDysk headless configuration secrets. `just init` prompts for the NNTP
# account and creates the API key. The provider JSON is shell-quoted as
# a Compose literal so punctuation in credentials survives interpolation. Compose
# maps these stack-facing names to the environment variables InfiniDysk expects.
INFINIDYSK_API_KEY=
INFINIDYSK_PROVIDERS=
# `just wire` fills this JSON with the Sonarr/Radarr API keys and the automatic
# queue-management rules for InfiniDysk.
INFINIDYSK_ARR_INSTANCES=

# Public Traefik routers are disabled by default. These are managed by
# `just public enable|disable <service>`; they do not open UFW or create DNS records.
# JELLYFIN_ENTRYPOINTS=
# SEERR_ENTRYPOINTS=
# RADARR_ENTRYPOINTS=
# SONARR_ENTRYPOINTS=
# PROWLARR_ENTRYPOINTS=
# BAZARR_ENTRYPOINTS=
# INFINIDYSK_ENTRYPOINTS=
