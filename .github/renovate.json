{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "customManagers": [
    {
      "customType": "regex",
      "datasourceTemplate": "docker",
      "managerFilePatterns": [
        "/^justfile$/"
      ],
      "matchStrings": [
        "restic_image\\s*:=\\s*\"(?<depName>[^:\"]+):(?<currentValue>[^\"]+)\"",
        "hunt_image\\s*:=\\s*\"(?<depName>[^:\"]+):(?<currentValue>[^\"]+)\""
      ]
    }
  ],
  "dependencyDashboard": true,
  "dependencyDashboardTitle": "kickstArrt (VPS) dependency dashboard",
  "enabledManagers": [
    "docker-compose",
    "github-actions",
    "pre-commit"
  ],
  "extends": [
    "config:recommended"
  ],
  "gitAuthor": "renovate[bot] <29139614+renovate[bot]@users.noreply.github.com>",
  "labels": [
    "renovate"
  ],
  "packageRules": [
    {
      "matchManagers": [
        "docker-compose"
      ],
      "matchPackageNames": [
        "lscr.io/linuxserver/jellyfin"
      ],
      "versioning": "loose"
    },
    {
      "automerge": false,
      "groupName": "github-actions",
      "groupSlug": "github-actions",
      "labels": [
        "renovate"
      ],
      "matchManagers": [
        "github-actions"
      ]
    },
    {
      "automerge": false,
      "groupName": "media-stack minor/patch",
      "groupSlug": "media-stack-minor-patch",
      "labels": [
        "renovate",
        "minor/patch"
      ],
      "matchManagers": [
        "custom.regex",
        "docker-compose"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ]
    },
    {
      "automerge": false,
      "groupName": "media-stack major",
      "groupSlug": "media-stack-major",
      "labels": [
        "renovate",
        "major"
      ],
      "matchManagers": [
        "custom.regex",
        "docker-compose"
      ],
      "matchUpdateTypes": [
        "major"
      ]
    }
  ],
  "separateMajorMinor": true,
  "separateMultipleMajor": true,
  "timezone": "UTC"
}
